{
  "name": "gamebuddy",
  "version": "0.1.0",
  "private": true,
  "description": "A real-time AI companion for Slay the Spire 2",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "spec:list": "openspec list",
    "spec:validate": "openspec validate --strict",
    "demo": "node harness/run-demo.js",
    "mod:build": "powershell -ExecutionPolicy Bypass -File .\\mod\\GameBuddyBridge\\build.ps1",
    "live:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\start-live.ps1",
    "dist:win": "electron-builder --win nsis --x64",
    "test:syntax": "node --check main.js && node --check preload.js && node --check src/renderer.js && node --check src/pet-sprite/index.js && node --check src/pet.js && node --check src/danmaku.js && node --check agent/danmaku/catalog.js && node --check agent/danmaku/director.js && node --check agent/danmaku/bridge-adapter.js && node --check agent/danmaku/codex-facts.js && node --check agent/danmaku/retrieval.js && node --check agent/danmaku/vector-store.js && node --check agent/danmaku/scene-context.js && node --check agent/danmaku/language-profile.js && node --check agent/danmaku/llm-atmosphere.js && node --check agent/llm/openai.js && node --check scripts/prepare-danmaku-corpus.js && node --check scripts/index-danmaku-corpus.js && node --check harness/validate-all.js",
    "test:agent": "node --test agent/tests/router.test.js",
    "test:danmaku": "node --test agent/tests/danmaku.test.js agent/tests/scene-context.test.js agent/tests/danmaku-corpus.test.js agent/tests/danmaku-llm.test.js",
    "test:danmaku-retrieval": "node --test agent/tests/danmaku-retrieval.test.js",
    "danmaku:vdb": "uvx --from chromadb==1.5.9 chroma run --path .runtime/danmaku-chroma --host 127.0.0.1 --port 8010",
    "danmaku:index": "node scripts/index-danmaku-corpus.js",
    "danmaku:prepare": "node scripts/prepare-danmaku-corpus.js",
    "harness:validate-observation": "node harness/validate-observation.js",
    "harness:validate-protocol": "node harness/validate-protocol.js",
    "harness:validate-all": "node harness/validate-all.js",
    "harness:validate": "node harness/validate-replay.js",
    "harness:validate-agent": "node harness/validate-agent.js",
    "harness:validate-live-launch": "node harness/validate-live-launch.js",
    "harness:replay": "node harness/replay-bridge.js",
    "harness:record": "node harness/record-bridge.js",
    "harness:inspect": "node harness/inspect-bridge.js",
    "harness:smoke": "node harness/smoke-replay.js",
    "harness:smoke:lifecycle": "node harness/smoke-replay.js --fixture harness/fixtures/lifecycle.json --events combat.started,turn.started,combat.ended,map.opened",
    "knowledge:cards": "node scripts/sync-card-evaluations.js"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.13.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.gamebuddy.sts2",
    "productName": "GameBuddy",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "agent/**/*",
      "harness/protocol.js",
      "harness/observation-store.js",
      "README.md",
      "docs/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GameBuddy-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GameBuddy"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
