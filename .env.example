# OpenAI-compatible service root. Both https://host and https://host/v1 work.
# 腾讯内部网关：将 TENCENT_TOKEN 写入本地 .secrets（被忽略），并使用以下配置。
GAMEBUDDY_LLM_BASE_URL=https://copilot.tencent.com/v2/
# 留空时，如果本地 .secrets 有 TENCENT_TOKEN，程序会仅在本机映射使用它。
GAMEBUDDY_LLM_API_KEY=
GAMEBUDDY_LLM_MODEL=deepseek-v4.1-flash
# Use responses when supported, otherwise use chat for /v1/chat/completions.
GAMEBUDDY_LLM_WIRE_API=chat
GAMEBUDDY_LLM_REASONING_EFFORT=low
# Optional Chat Completions temperature. kimi-k2.5 / kimi-k2.6 only accept 0.6.
# GAMEBUDDY_LLM_TEMPERATURE=0.6
# Disable thinking-capable models for real-time route/card advice (often 3-5s instead of 30-60s).
GAMEBUDDY_LLM_THINKING=disabled
# 腾讯内部网关使用 SSE 时打开；普通非流式 OpenAI 服务保持 false。
GAMEBUDDY_LLM_STREAM=true
# 实时建议的输出上限，给内部模型保留足够空间产出最终 JSON。
GAMEBUDDY_LLM_MAX_TOKENS=512
# 弹幕素材库独立于 Hy-Memory；启动 npm run danmaku:vdb 后使用默认地址即可。
GAMEBUDDY_DANMAKU_CHROMA_URL=http://127.0.0.1:8010
GAMEBUDDY_DANMAKU_COLLECTION=gamebuddy_danmaku_v1
GAMEBUDDY_DANMAKU_OLLAMA_URL=http://127.0.0.1:11434
GAMEBUDDY_DANMAKU_EMBED_MODEL=nomic-embed-text
OPENAI_API_KEY=
GAMEBUDDY_SPIRE_CODEX_URL=https://spire-codex.com/api
GAMEBUDDY_CARD_DATA_CHANNEL=stable
# Optional reproducible snapshot override, for example v0.107.1.
GAMEBUDDY_CARD_DATA_VERSION=
